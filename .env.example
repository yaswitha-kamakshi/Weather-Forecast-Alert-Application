# Copy to ".env" and fill in. NEVER commit ".env".

# Open-Meteo (default provider) needs NO key.

# OpenWeatherMap (optional provider): free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Optional email alerts (Gmail: use a 16-character App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
ALERT_TO=receiver@example.com
